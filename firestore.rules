rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && (request.auth.token.email == 'administrador@siga.com'
          || request.auth.token.email == 'operador@siga.com');
    }

    function validAffiliate(affiliateId, appId) {
      return request.resource.data.keys().hasAll(['id', 'name', 'number', 'dni', 'status', 'uniqueDniKey', 'uniqueNumberKey'])
        && request.resource.data.id == affiliateId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.number is string
        && request.resource.data.number.size() > 0
        && request.resource.data.number.size() <= 80
        && request.resource.data.dni is string
        && request.resource.data.dni.matches('^[0-9 .-]{7,15}$')
        && request.resource.data.status in ['Activo', 'Jubilado', 'Inactivo']
        && request.resource.data.uniqueDniKey is string
        && request.resource.data.uniqueDniKey.matches('^dni_[A-Za-z0-9_-]+$')
        && request.resource.data.uniqueNumberKey is string
        && request.resource.data.uniqueNumberKey.matches('^number_[A-Za-z0-9_-]+$')
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/unique_affiliates/$(request.resource.data.uniqueDniKey)).data.affiliateId == affiliateId
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/unique_affiliates/$(request.resource.data.uniqueNumberKey)).data.affiliateId == affiliateId;
    }

    function validPayment(paymentId, appId) {
      return request.resource.data.keys().hasAll(['id', 'affiliateId', 'name', 'period', 'amount', 'timestamp'])
        && request.resource.data.id == paymentId
        && request.resource.data.affiliateId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.period is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.timestamp is string
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(request.resource.data.affiliateId));
    }

    // Solo las cuentas administrativas autorizadas pueden acceder al padrón.
    // Las sesiones anónimas y las cuentas móviles quedan excluidas.
    match /artifacts/{appId}/public/data/afiliados/{affiliateId} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff() && validAffiliate(affiliateId, appId);
    }

    match /artifacts/{appId}/public/data/pagos/{paymentId} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff() && validPayment(paymentId, appId);
    }

    match /artifacts/{appId}/public/unique_affiliates/{uniqueKey} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['affiliateId', 'type'])
        && request.resource.data.affiliateId is string
        && request.resource.data.type in ['dni', 'number']
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(request.resource.data.affiliateId)).data.id == request.resource.data.affiliateId;
    }

    match /artifacts/{appId}/mobile_credentials/{userId} {
      allow read: if signedIn()
        && request.auth.uid == userId
        && resource.data.enabled == true
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(resource.data.affiliateId));
      allow create, update: if isStaff();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
