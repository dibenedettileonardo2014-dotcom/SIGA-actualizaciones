rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && (request.auth.token.email == 'administrador@siga.com'
          || request.auth.token.email == 'operador@siga.com');
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'administrador@siga.com';
    }

    function maintenanceEnabled(appId) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/public/config/maintenance/state)
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/config/maintenance/state).data.enabled == true;
    }

    function isStaffOperational(appId) {
      return isStaff() && (isAdmin() || !maintenanceEnabled(appId));
    }

    function isEnabledAffiliate(appId) {
      return signedIn()
        && exists(/databases/$(database)/documents/artifacts/$(appId)/mobile_credentials/$(request.auth.uid))
        && get(/databases/$(database)/documents/artifacts/$(appId)/mobile_credentials/$(request.auth.uid)).data.enabled == true;
    }

    function validAffiliate(affiliateId, appId) {
      return request.resource.data.keys().hasAll(['id', 'name', 'number', 'dni', 'status', 'uniqueDniKey', 'uniqueNumberKey', 'revision', 'clientMutationId'])
        && request.resource.data.id == affiliateId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.number is string
        && request.resource.data.number.size() > 0
        && request.resource.data.number.size() <= 80
        && request.resource.data.dni is string
        && request.resource.data.dni.matches('^[0-9 .-]{7,15}$')
        && request.resource.data.status in ['Activo', 'Jubilado', 'Inactivo']
        && request.resource.data.uniqueDniKey is string
        && request.resource.data.uniqueDniKey.matches('^dni_[A-Za-z0-9_-]+$')
        && request.resource.data.uniqueNumberKey is string
        && request.resource.data.uniqueNumberKey.matches('^number_[A-Za-z0-9_-]+$')
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.clientMutationId is string
        && request.resource.data.clientMutationId.size() >= 16
        && request.resource.data.clientMutationId.size() <= 80
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/unique_affiliates/$(request.resource.data.uniqueDniKey)).data.affiliateId == affiliateId
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/unique_affiliates/$(request.resource.data.uniqueNumberKey)).data.affiliateId == affiliateId;
    }

    function validPayment(paymentId, appId) {
      return request.resource.data.keys().hasAll(['id', 'affiliateId', 'affiliateNumber', 'dni', 'name', 'company', 'period', 'concept', 'uniquenessKey', 'clientMutationId', 'amount', 'timestamp'])
        && request.resource.data.id == paymentId
        && request.resource.data.affiliateId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.affiliateNumber is string
        && request.resource.data.dni is string
        && request.resource.data.company is string
        && request.resource.data.period is string
        && request.resource.data.concept is string
        && request.resource.data.concept.size() > 0
        && request.resource.data.concept.size() <= 80
        && request.resource.data.uniquenessKey is string
        && request.resource.data.clientMutationId is string
        && request.resource.data.clientMutationId.size() >= 16
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.timestamp is string
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(request.resource.data.affiliateId))
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(request.resource.data.affiliateId)).data.number == request.resource.data.affiliateNumber
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(request.resource.data.affiliateId)).data.dni == request.resource.data.dni
        && ((!get(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(request.resource.data.affiliateId)).data.keys().hasAll(['company']) && request.resource.data.company == '')
          || (get(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(request.resource.data.affiliateId)).data.keys().hasAll(['company'])
            && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(request.resource.data.affiliateId)).data.company == request.resource.data.company));
    }

    function validMobileCredential(appId) {
      return request.resource.data.keys().hasAll(['affiliateId', 'name', 'number', 'dni', 'status', 'familyGroup', 'enabled', 'updatedAt'])
        && request.resource.data.affiliateId is string
        && request.resource.data.name is string
        && request.resource.data.number is string
        && request.resource.data.dni is string
        && request.resource.data.dni.matches('^[0-9 .-]{7,15}$')
        && request.resource.data.status in ['Activo', 'Jubilado', 'Inactivo']
        && request.resource.data.familyGroup is map
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt is string
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(request.resource.data.affiliateId))
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(request.resource.data.affiliateId)).data.name == request.resource.data.name
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(request.resource.data.affiliateId)).data.number == request.resource.data.number
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(request.resource.data.affiliateId)).data.dni == request.resource.data.dni;
    }

    function validDiagnostic() {
      return request.resource.data.keys().hasAll(['id', 'source', 'code', 'message', 'context', 'severity', 'appVersion', 'revision', 'deviceId', 'occurredAt', 'repeatCount', 'status', 'reporterUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'source', 'code', 'message', 'context', 'severity', 'appVersion', 'revision', 'deviceId', 'occurredAt', 'repeatCount', 'status', 'reporterUid', 'createdAt'])
        && request.resource.data.id is string
        && request.resource.data.id.size() >= 16
        && request.resource.data.id.size() <= 80
        && request.resource.data.source in ['pc', 'mobile']
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.context is string
        && request.resource.data.context.size() <= 500
        && request.resource.data.severity in ['warning', 'error', 'critical']
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 20
        && request.resource.data.revision is string
        && request.resource.data.revision.size() <= 30
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() <= 80
        && request.resource.data.occurredAt is string
        && request.resource.data.occurredAt.size() <= 40
        && request.resource.data.repeatCount is int
        && request.resource.data.repeatCount > 0
        && request.resource.data.repeatCount <= 999
        && request.resource.data.status == 'open'
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.createdAt is timestamp;
    }

    function validNotice(noticeId) {
      return request.resource.data.keys().hasAll(['id', 'title', 'text', 'publishedAt', 'important', 'published'])
        && request.resource.data.id == noticeId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 20000
        && request.resource.data.publishedAt is string
        && request.resource.data.important is bool
        && request.resource.data.published == true;
    }

    function validNoticeChunk() {
      return request.resource.data.keys().hasAll(['noticeId', 'kind', 'index', 'total', 'data'])
        && request.resource.data.kind in ['image', 'thumbnail', 'pdf']
        && request.resource.data.noticeId is string
        && request.resource.data.noticeId.size() > 0
        && request.resource.data.noticeId.size() <= 100
        && request.resource.data.index is int
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 64
        && request.resource.data.index >= 0
        && request.resource.data.index < request.resource.data.total
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 360000;
    }

    // Solo las cuentas administrativas autorizadas pueden acceder al padrón.
    // Las sesiones anónimas y las cuentas móviles quedan excluidas.
    match /artifacts/{appId}/public/data/afiliados/{affiliateId} {
      allow read, delete: if isStaffOperational(appId);
      allow create: if isStaffOperational(appId)
        && validAffiliate(affiliateId, appId)
        && request.resource.data.revision == 1;
      allow update: if isStaffOperational(appId)
        && validAffiliate(affiliateId, appId)
        && ((!resource.data.keys().hasAll(['revision']) && request.resource.data.revision == 1)
          || (resource.data.revision is int && request.resource.data.revision == resource.data.revision + 1));
    }

    match /artifacts/{appId}/public/data/pagos/{paymentId} {
      allow read, delete: if isStaffOperational(appId);
      allow create, update: if isStaffOperational(appId) && validPayment(paymentId, appId);
    }

    match /artifacts/{appId}/public/data/unique_affiliates/{uniqueKey} {
      allow read, delete: if isStaffOperational(appId);
      allow create: if isStaffOperational(appId)
        && request.resource.data.keys().hasOnly(['affiliateId', 'type'])
        && request.resource.data.affiliateId is string
        && request.resource.data.type in ['dni', 'number']
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(request.resource.data.affiliateId)).data.id == request.resource.data.affiliateId;
      allow update: if false;
    }

    match /artifacts/{appId}/mobile_credentials/{userId} {
      allow read: if signedIn()
        && request.auth.uid == userId
        && resource.data.enabled == true
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(resource.data.affiliateId));
      allow create: if isStaffOperational(appId) && validMobileCredential(appId);
      allow update: if isStaffOperational(appId)
        && request.resource.data.affiliateId == resource.data.affiliateId
        && validMobileCredential(appId);
      allow delete: if false;
    }

    // Administración gestiona todo; el operador puede crear publicaciones.
    // Los adjuntos se fragmentan para respetar el límite de documento.
    match /artifacts/{appId}/public/data/comunicados/{noticeId} {
      allow read: if isAdmin() || (!maintenanceEnabled(appId) && (isStaff() || isEnabledAffiliate(appId)));
      allow create, update: if isStaffOperational(appId) && validNotice(noticeId);
      allow delete: if isStaffOperational(appId);
    }

    match /artifacts/{appId}/public/data/comunicado_files/{chunkId} {
      allow read: if isAdmin() || (!maintenanceEnabled(appId) && (isStaff() || isEnabledAffiliate(appId)));
      allow create, update: if isStaffOperational(appId) && validNoticeChunk();
      allow delete: if isStaffOperational(appId);
    }

    match /artifacts/{appId}/mobile_reads/{userId}/items/{noticeId} {
      allow read: if !maintenanceEnabled(appId) && isEnabledAffiliate(appId) && request.auth.uid == userId;
      allow create, update: if !maintenanceEnabled(appId) && isEnabledAffiliate(appId) && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['noticeId', 'readAt'])
        && request.resource.data.noticeId == noticeId
        && request.resource.data.readAt is string
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/comunicados/$(noticeId));
      allow delete: if false;
    }

    match /artifacts/{appId}/diagnostics/{eventId} {
      allow read: if isAdmin();
      allow create: if (isStaff() || isEnabledAffiliate(appId))
        && request.resource.data.id == eventId
        && validDiagnostic();
      allow update, delete: if isAdmin();
    }

    match /artifacts/{appId}/public/config/affiliate_sequence/state {
      allow read: if isStaffOperational(appId);
      allow create, update: if isStaffOperational(appId)
        && request.resource.data.keys().hasOnly(['nextNumber', 'updatedAt'])
        && request.resource.data.nextNumber is int
        && request.resource.data.nextNumber > 0
        && request.resource.data.updatedAt is timestamp
        && (!exists(/databases/$(database)/documents/artifacts/$(appId)/public/config/affiliate_sequence/state)
          || request.resource.data.nextNumber >= resource.data.nextNumber);
      allow delete: if false;
    }

    match /artifacts/{appId}/public/config/maintenance/state {
      // El móvil debe conocer el bloqueo incluso antes de iniciar sesión.
      // El documento sólo contiene el estado y el mensaje público.
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['enabled', 'title', 'message', 'updatedAt', 'updatedBy'])
        && request.resource.data.enabled is bool
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.estimatedReturn is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/maintenance_audit/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['action', 'enabled', 'title', 'message', 'estimatedReturn', 'administrator', 'occurredAt'])
        && request.resource.data.action in ['activated', 'deactivated']
        && request.resource.data.enabled is bool
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.estimatedReturn is string
        && request.resource.data.administrator == request.auth.token.email
        && request.resource.data.occurredAt is timestamp;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
