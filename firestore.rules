rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && (request.auth.token.email == 'administrador@siga.com'
          || request.auth.token.email == 'operador@siga.com');
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'administrador@siga.com';
    }

    function isEnabledAffiliate(appId) {
      return signedIn()
        && exists(/databases/$(database)/documents/artifacts/$(appId)/mobile_credentials/$(request.auth.uid))
        && get(/databases/$(database)/documents/artifacts/$(appId)/mobile_credentials/$(request.auth.uid)).data.enabled == true;
    }

    function validAffiliate(affiliateId, appId) {
      return request.resource.data.keys().hasAll(['id', 'name', 'number', 'dni', 'status', 'uniqueDniKey', 'uniqueNumberKey', 'revision', 'clientMutationId'])
        && request.resource.data.id == affiliateId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.number is string
        && request.resource.data.number.size() > 0
        && request.resource.data.number.size() <= 80
        && request.resource.data.dni is string
        && request.resource.data.dni.matches('^[0-9 .-]{7,15}$')
        && request.resource.data.status in ['Activo', 'Jubilado', 'Inactivo']
        && request.resource.data.uniqueDniKey is string
        && request.resource.data.uniqueDniKey.matches('^dni_[A-Za-z0-9_-]+$')
        && request.resource.data.uniqueNumberKey is string
        && request.resource.data.uniqueNumberKey.matches('^number_[A-Za-z0-9_-]+$')
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.clientMutationId is string
        && request.resource.data.clientMutationId.size() >= 16
        && request.resource.data.clientMutationId.size() <= 80
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/unique_affiliates/$(request.resource.data.uniqueDniKey)).data.affiliateId == affiliateId
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/unique_affiliates/$(request.resource.data.uniqueNumberKey)).data.affiliateId == affiliateId;
    }

    function validPayment(paymentId, appId) {
      return request.resource.data.keys().hasAll(['id', 'affiliateId', 'name', 'period', 'amount', 'timestamp'])
        && request.resource.data.id == paymentId
        && request.resource.data.affiliateId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.period is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.timestamp is string
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(request.resource.data.affiliateId));
    }

    // Solo las cuentas administrativas autorizadas pueden acceder al padrón.
    // Las sesiones anónimas y las cuentas móviles quedan excluidas.
    match /artifacts/{appId}/public/data/afiliados/{affiliateId} {
      allow read, delete: if isStaff();
      allow create: if isStaff()
        && validAffiliate(affiliateId, appId)
        && request.resource.data.revision == 1;
      allow update: if isStaff()
        && validAffiliate(affiliateId, appId)
        && ((!resource.data.keys().hasAll(['revision']) && request.resource.data.revision == 1)
          || (resource.data.revision is int && request.resource.data.revision == resource.data.revision + 1));
    }

    match /artifacts/{appId}/public/data/pagos/{paymentId} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff() && validPayment(paymentId, appId);
    }

    match /artifacts/{appId}/public/data/unique_affiliates/{uniqueKey} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['affiliateId', 'type'])
        && request.resource.data.affiliateId is string
        && request.resource.data.type in ['dni', 'number'];
    }

    match /artifacts/{appId}/mobile_credentials/{userId} {
      allow read: if signedIn()
        && request.auth.uid == userId
        && resource.data.enabled == true
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/afiliados/$(resource.data.affiliateId));
      allow create, update: if isStaff();
      allow delete: if false;
    }

    // Publicaciones: solo administración crea o altera contenido. Los adjuntos
    // se fragmentan para respetar el límite de documento y se leen bajo demanda.
    match /artifacts/{appId}/public/data/comunicados/{noticeId} {
      allow read: if isStaff() || isEnabledAffiliate(appId);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['id', 'title', 'text', 'publishedAt', 'important', 'published'])
        && request.resource.data.id == noticeId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 20000
        && request.resource.data.publishedAt is string
        && request.resource.data.important is bool
        && request.resource.data.published == true;
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/comunicado_files/{chunkId} {
      allow read: if isStaff() || isEnabledAffiliate(appId);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['noticeId', 'kind', 'index', 'total', 'data'])
        && request.resource.data.kind in ['image', 'thumbnail', 'pdf']
        && request.resource.data.index is int
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 360000;
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/mobile_reads/{userId}/items/{noticeId} {
      allow read: if isEnabledAffiliate(appId) && request.auth.uid == userId;
      allow create, update: if isEnabledAffiliate(appId) && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['noticeId', 'readAt'])
        && request.resource.data.noticeId == noticeId
        && request.resource.data.readAt is string
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/comunicados/$(noticeId));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
