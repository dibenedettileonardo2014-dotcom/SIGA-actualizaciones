{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [{"key":"Cache-Control","value":"no-cache"}]
      },
      {
        "source": "/**/*.@(html|json)",
        "headers": [{"key":"Cache-Control","value":"no-cache"}]
      }
    ]
  }
}
